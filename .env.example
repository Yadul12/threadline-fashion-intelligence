# THREADLINE — Fashion Discovery & Customer Experience Intelligence Platform
# Copy this file to .env and fill in optional integration credentials.
# Never commit real API keys or credentials to version control.

# 1. Database Configuration
# Primary PostgreSQL connection string (used when PostgreSQL is running):
# DATABASE_URL=postgresql+psycopg://threadline:threadline_dev_pw@localhost:5432/threadline
# If DATABASE_URL is unset and local PostgreSQL is unavailable, the backend falls back
# to a local relational SQLite database with enforced foreign keys:
DATABASE_URL=

# 2. Mixpanel Product Analytics Configuration
# Provide your Mixpanel Project Token to enable live cloud event ingestion alongside local SQL persistence.
MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# 3. Google Gemini API Configuration (Server-Side GenAI Customer Intelligence)
# Provide a Gemini API key to run live LLM synthesis using `gemini-4-hydrogen` via `google-genai`.
# When unset, the backend uses a deterministic, evidence-backed fallback engine over SQL review records.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# 4. Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
